# Copie para .env e preencha os valores reais (não commite o .env)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Onde salvar a carteira gerada (arquivo SQLite). No servidor, use uma pasta com backup.
CARTEIRA_DB_PATH=dados_app/carteira.db
# Senha da visão de gestor (gerar carteira e ver todos os cobradores)
GESTOR_SENHA=
